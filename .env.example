APP_NAME=LocaFiesta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://booking.locafiesta.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=locafiesta
DB_USERNAME=locafiesta_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mail.locafiesta.fr
MAIL_PORT=587
MAIL_USERNAME=no-reply@locafiesta.fr
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@locafiesta.fr"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=pk_live_your_key
STRIPE_SECRET=sk_live_your_secret
STRIPE_WEBHOOK_SECRET=whsec_your_secret

DEPOSIT_PERCENTAGE=30
